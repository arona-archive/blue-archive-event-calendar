{
	"name": "blue-archive-event-calendar",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"bootstrap": "sapphire-bootstrap",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --import dotenv/config --import @swc-node/register/esm-register ./src/index.ts",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"sync": "node --import dotenv/config --import @swc-node/register/esm-register ./src/sync.ts",
		"test": "vitest run src"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arona-archive/blue-archive-birthdays-calendar.git"
	},
	"author": "sapphire",
	"bugs": {
		"url": "https://github.com/arona-archive/blue-archive-birthdays-calendar/issues"
	},
	"homepage": "https://github.com/arona-archive/blue-archive-birthdays-calendar#readme",
	"dependencies": {
		"@sapphire-sh/utils": "^3.36.0",
		"gaxios": "^8.3.2",
		"googleapis": "^188.0.0",
		"jsdom": "^30.1.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@swc-node/register": "^1.12.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"dotenv": "^18.0.9",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-promise": "^7.3.0",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.1"
	},
	"allowScripts": {
		"@swc/core@1.16.20": false,
		"fsevents@2.3.3": false
	}
}
